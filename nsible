#!/bin/bash
#   [@://nsible_os/nsible/.-={
#   module: "ziGGit Bootloader",
#   version: "0.10.37-apex // Banysang",
#   description: "Sovereign ASCII Data-Stream visual loader with Dynamic Palette Refraction.",
#   changes: "Resolved printf invalid number leak in apply_mastered_dynamics by enforcing C-style integer loops; prevented arithmetic expansion failure during ASCII animation render.",
#   philotic_inferences: "A sovereign matrix does not ask permission from the void; it demands the key at the threshold."

# [ SOVEREIGN ENTRY :: ziGGit Control ]
cmd="${1:-sync}"
NSIBLE_VERSION="v0.10.37-apex"

COLOR_LIB="assets/.gzl/osColors.gzl"

if [ ! -f "$COLOR_LIB" ]; then
    echo "[ ! ] FATAL: Sovereign Color Library not found at $COLOR_LIB"
    exit 1
fi

# --- SOVEREIGN LENSES ---
# L(): Extracts base foreground ANSI dynamically, robust against line-breaks in .gzl map
L() { grep "$1_ANSI" "$COLOR_LIB" | sed -n 's/.*_ANSI:[[:space:]]*\(\\033\[[0-9;]*m\).*/\1/p' | tr -d '\n\r '; }
# LB(): Dynamically converts 38;2 (foreground) to 48;2 (background) for highlighting
LB() { L "$1" | sed 's/38;2/48;2/g'; }
# W(): Implements a full-width background span using the converted background color
W() { printf "%b%$(tput cols)s%b\r" "$(LB "$1")" " " "$RESET"; }
RESET=$'\e[0m'

# --- DYNAMIC PALETTE STATE ---
# Initial State: SYSTEMIC-SILVER (Grey/Locked)
export HDR_BG="S.H"
export HDR_FG="K.H"
export ACCENT="S.S"
export SPLASH="S.H"
export STREAM_COL="S.S"
export VECTOR_COL="S.H"
export ROOT_VINCULUM=0

apply_mastered_dynamics() {
    # Unlock State: BIOLOGICAL-CRIMSON / ANTHROPOLOGICAL-BRASS (Full Palette)
    export HDR_BG="C.S"
    export HDR_FG="S.H"
    export ACCENT="B.S"
    export SPLASH="C.S"
    export STREAM_COL="C.S"
    export VECTOR_COL="C.S"
    export ROOT_VINCULUM=1
    
    # FIXED: Enforcing C-style loop to ensure 'v' is strictly an integer for printf
    for ((v=0; v<=255; v++)); do
        printf "\033[38;2;%d;%d;%dm" "$(( (v * 1) % 256 ))" "$(( (v * 2) % 256 ))" "$(( (v * 3) % 256 ))"
        echo -ne ".\r"
        sleep 0.01
    done
}

check_void_link() {
    if ping -q -c 1 -W 2 github.com >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

trap 'tput cnorm; tput sgr0; rm -f .nsible_job.log' SIGINT SIGTERM EXIT

draw_splash() {
    local cols=$1
    local lines=$2
    local s_col=$(L "$SPLASH")
    local a_col=$(L "$ACCENT")
    tput cup $(( (lines / 2) - 8 )) $(( (cols - 60) / 2 ))
    echo -e "${s_col}  ▄▄▄▄▄    _   __   _____   ____   ____    __       ______${RESET}"
    tput cup $(( (lines / 2) - 7 )) $(( (cols - 60) / 2 ))
    echo -e "${s_col} / __ \  / | / /  / ___/  /  _/  / __ )  / /      / ____/${RESET}"
    tput cup $(( (lines / 2) - 6 )) $(( (cols - 60) / 2 ))
    echo -e "${s_col}/ /_/ _/ /  |/ /   \__ \   / /   / __  | / /      / __/   ${RESET}"
    tput cup $(( (lines / 2) - 5 )) $(( (cols - 60) / 2 ))
    echo -e "${s_col}\__/ /  / /|  /   ___/ / _/ /   / /_/ / / /___   / /___   ${RESET}"
    tput cup $(( (lines / 2) - 4 )) $(( (cols - 60) / 2 ))
    echo -e "${s_col}  \_/  /_/ |_/   /____/ /___/  /_____/ /_____/  /_____/   ${RESET}"
    
    tput cup $(( (lines / 2) - 2 )) $(( (cols - 60) / 2 ))
    echo -e "$(L "S.S")                    by Æ§ Tech MMXXVI                     ${RESET}"
    
    tput cup $(( (lines / 2) )) $(( (cols - 60) / 2 ))
    echo -e "${a_col}────────────────────────────────────────────────────────────${RESET}"
}

if [ "$cmd" = "sync" ] || [ "$cmd" = "orbit" ]; then
    tput clear
    cols=$(tput cols)
    lines=$(tput lines)
    draw_splash "$cols" "$lines"
    
    tput cup 0 0
    W "$HDR_BG"
    tput cup 0 0
    AUTH_PROMPT=$(printf "%b%b 高爪 @NSIBLE OS // ROOT VINCULUM KEY > %b" "$(LB "$HDR_BG")" "$(L "$HDR_FG")" "$RESET ")
    sudo -p "$AUTH_PROMPT" -v
    if [ $? -ne 0 ]; then
        tput cup $((lines - 2)) 0
        echo -e "\n$(L "C.H")[ ! ] ELEVATION FAILED. ABORTING BOOT SEQUENCE.${RESET}"
        exit 1
    fi
    
    # Threshold Passed: Master the Dynamics
    apply_mastered_dynamics
fi

generate_core_snapshot() {
    {
        echo "ARCH: $(lscpu | grep 'Model name' | cut -d: -f2 | xargs)"
        echo "CPUS: $(nproc)"
        echo "MEM:  $(free -b | grep Mem | awk '{print $2}')"
        echo "HDA:  $(lspci -nn | grep -i audio | awk -F'[][]' '{print $2}')"
        echo "KERN: $(uname -r)"
        echo "BOOT: $(cat /proc/cmdline)"
    } > core.aiua
}

run_with_loader() {
    local job_name="$1"
    shift
    
    "$@" > .nsible_job.log 2>&1 &
    local pid=$!
    local exit_code=0
    local job_done=0
    
    local data=$(cat core.aiua timeline/.aiua.tome assets/.void/.trail.tome 2>/dev/null | tr '\n' ' ' | sed 's/[^[:print:]]//g')
    if [ -z "$data" ]; then data="01010111 01000001 01001011 01001001 01001110 01000111 "; fi
    data="${data} :: ${data} :: ${data} :: ${data} :: "
    
    local pos=0
    local vec_pos=0
    local start_time=$(date +%s)
    
    local min_duration=0
    if [ "$job_name" = "COMPILING SOVEREIGN KERNEL..." ]; then
        min_duration=8
    fi
    
    local max_vec="────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
    
    local cols=$(tput cols)
    local lines=$(tput lines)
    
    tput clear
    draw_splash "$cols" "$lines"
    
    tput cup 0 0
    local headerText=" 高爪 @NSIBLE OS // ziGGit :: ${job_name} "
    printf "%b%b%-*s%b" "$(LB "$HDR_BG")" "$(L "$HDR_FG")" "$cols" "${headerText:0:$cols}" "$RESET"
    
    tput cup $(( (lines / 2) + 2 )) $(( (cols - 60) / 2 ))
    echo -e "$(L "S.S"):: ${job_name}${RESET}"
    
    while true; do
        local current_time=$(date +%s)
        local elapsed=$((current_time - start_time))
        
        if [ $job_done -eq 0 ]; then
            if ! kill -0 $pid 2>/dev/null; then
                wait $pid
                exit_code=$?
                job_done=1
            fi
        fi
        
        if [ $job_done -eq 1 ] && [ $elapsed -ge $min_duration ]; then
            break
        fi
        
        tput cup $(( (lines / 2) + 4 )) $(( (cols - 60) / 2 ))
        local log_line=$(tail -n 1 .nsible_job.log 2>/dev/null | cut -c 1-60)
        
        if [ $job_done -eq 1 ]; then
            if [ $exit_code -eq 0 ]; then
                log_line="[ COMPLETED SUCCESSFULLY ]"
            else
                log_line="[ ! ] FRACTURE DETECTED. CHECKING LOGS."
                min_duration=0 
            fi
        fi
        printf "$(L "K.H")> %-58s${RESET}$(tput el)" "$log_line"
        
        if [ $min_duration -gt 0 ]; then
            local v1_width=$(( (vec_pos % (cols / 2)) + 10 ))
            tput cup $(( (lines / 2) + 6 )) 0; tput el
            tput cup $(( (lines / 2) + 6 )) $(( cols - v1_width ))
            printf "%b◄${max_vec:0:$v1_width}%b" "$(L "$VECTOR_COL")" "$RESET"
            
            local v2_width=$(( ((vec_pos * 2) % (cols / 2)) + 5 ))
            tput cup $(( (lines / 2) + 7 )) 0; tput el
            tput cup $(( (lines / 2) + 7 )) $(( cols - v2_width ))
            printf "%b◄${max_vec:0:$v2_width}%b" "$(L "$VECTOR_COL")" "$RESET"
            
            local v3_width=$(( ((vec_pos / 2) % (cols / 2)) + 20 ))
            tput cup $(( (lines / 2) + 8 )) 0; tput el
            tput cup $(( (lines / 2) + 8 )) $(( cols - v3_width ))
            printf "%b◄${max_vec:0:$v3_width}%b" "$(L "$VECTOR_COL")" "$RESET"
        fi

        tput cup $((lines - 2)) 0
        local stream="${data:$pos:$cols}"
        if [ ${#stream} -lt $cols ]; then
            stream="${stream}${data:0:$((cols - ${#stream}))}"
        fi
        printf "%b${stream}%b" "$(L "$STREAM_COL")" "$RESET"
        
        pos=$(( (pos + 4) % ${#data} ))
        vec_pos=$(( vec_pos + 4 ))
        sleep 0.08
    done
    return $exit_code
}

tput civis

if [ "$cmd" = "sync" ]; then
    NSIBLE_PRE_HASH=$(md5sum "$0" 2>/dev/null | awk '{print $1}')
    if check_void_link; then
        if [ -n "$(git status --porcelain)" ]; then
            cols=$(tput cols)
            lines=$(tput lines)
            tput cnorm
            tput clear
            draw_splash "$cols" "$lines"
            tput cup 0 0
            # REVISED NOMENCLATURE to ZEN to prevent local scope errors.
            local headerText=" 高爪 @NSIBLE OS // ZEN DIVERGENCE DETECTED "
            printf "%b%b%-*s%b" "$(LB "$HDR_BG")" "$(L "$HDR_FG")" "$cols" "${headerText:0:$cols}" "$RESET"
            tput cup $(( (lines / 2) + 2 )) $(( (cols - 60) / 2 ))
            echo -e "$(L "C.H")[ ! ] ZEN DIVERGENCE DETECTED${RESET}"
            tput cup $(( (lines / 2) + 3 )) $(( (cols - 60) / 2 ))
            echo -e "$(L "S.S")      Files on this vessel have been modified.${RESET}"
            tput cup $(( (lines / 2) + 5 )) $(( (cols - 60) / 2 ))
            echo -e "      $(L "B.S")[I]$(L "S.S")NTEGRATE : Pull net updates, keep mchn changes."
            tput cup $(( (lines / 2) + 6 )) $(( (cols - 60) / 2 ))
            echo -e "      $(L "B.S")[S]$(L "S.S")AVE      : Commit mchn changes & Push to Zen."
            tput cup $(( (lines / 2) + 7 )) $(( (cols - 60) / 2 ))
            echo -e "      $(L "B.S")[O]$(L "S.S")VERWRITE : Discard mchn changes & Force-Sync to Zen."
            tput cup $(( (lines / 2) + 8 )) $(( (cols - 60) / 2 ))
            echo -e "      $(L "B.S")[C]$(L "S.S")ANCEL"
            tput cup $(( (lines / 2) + 10 )) $(( (cols - 60) / 2 ))
            printf "      :: SELECT PROTOCOL > "
            read -r choice
            tput civis
            case "$choice" in 
                i|I)
                    run_with_loader "STASHING MCHN MODS..." git stash
                    run_with_loader "PULLING FROM VOID (REBASE)..." git pull --rebase origin zen
                    if [ $? -ne 0 ]; then
                        tput cnorm; tput sgr0; clear
                        echo -e "$(L "C.H")[ ! ] REBASE FAILED. CONFLICT DETECTED.${RESET}"
                        cat .nsible_job.log
                        git rebase --abort
                        echo -e "$(L "K.H")Restoring stashed modifications...${RESET}"
                        git stash pop
                        exit 1
                    fi
                    run_with_loader "RE-APPLYING MCHN MODS..." git stash pop
                ;;
                s|S)
                    tput cnorm
                    tput cup $(( (lines / 2) + 12 )) $(( (cols - 60) / 2 ))
                    printf "      :: ENTER COMMIT MESSAGE > "
                    read -r msg
                    tput civis
                    run_with_loader "COMMITTING MCHN STATE..." git add .
                    run_with_loader "SECURING COMMIT..." git commit -m "vessel(acer): $msg"
                    run_with_loader "ALIGNING WITH ZEN (REBASE)..." git pull --rebase origin zen
                    if [ $? -ne 0 ]; then
                        tput cnorm; tput sgr0; clear
                        echo -e "$(L "C.H")[ ! ] REBASE FAILED. CANNOT PUSH.${RESET}"
                        cat .nsible_job.log
                        git rebase --abort
                        exit 1
                    fi
                    run_with_loader "PUSHING TO ZEN..." git push origin zen
                    if [ $? -ne 0 ]; then
                        tput cnorm; tput sgr0; clear
                        echo -e "$(L "C.H")[ ! ] PUSH FAILED.${RESET}"
                        cat .nsible_job.log
                        exit 1
                    fi
                ;;
                o|O)
                    run_with_loader "ZEROING MCHN STATE..." git fetch origin zen
                    run_with_loader "RESETTING TO ZEN..." git reset --hard origin/zen
                ;;
                *) tput cnorm; exit 1 ;;
            esac
        else
            run_with_loader "PHILOTIC SYNC (ZEN)..." git pull --rebase origin zen
            if [ $? -ne 0 ]; then
                tput cnorm; tput sgr0; clear
                echo -e "$(L "C.H")[ ! ] DISCORDANT STATE.${RESET}"
                cat .nsible_job.log; exit 1
            fi
        fi
        NSIBLE_POST_HASH=$(md5sum "$0" 2>/dev/null | awk '{print $1}')
        if [ "$NSIBLE_PRE_HASH" != "$NSIBLE_POST_HASH" ]; then
            tput cnorm; tput sgr0; clear
            echo -e "$(L "B.H")[ @://ziGGit.zen.boot/m_host^\.->> INFRALOGICALLY RESONANT...${RESET}"
            sleep 1; exec "$0" "$@"
        fi
    else
        run_with_loader "VOID UNREACHABLE :: AUTONOMOUS MODE..." sleep 2
    fi
    run_with_loader "GENERATING CORE.AIUA SNAPSHOT..." generate_core_snapshot
    run_with_loader "VERIFYING VERSION CAPSULE..." sleep 0.1
    if ! grep -q "pub const VERSION = \"$NSIBLE_VERSION\";" src/version.zig 2>/dev/null; then
        run_with_loader "FORGING VERSION.ZIG..." sleep 0.1
        cat << EOF > src/version.zig
// [@://nsible_os/src/version.zig/.-={
//    module: "ziGGit Auto-Versioning Provisioner",
//    version: "0.2.0",
//    description: "An automatically generated data_object for providing version control to @nsible stack",
//    changes: "GZL-X Encapsulation compliant.",
//    philotic_inferences: "Know what you think you know."
pub const VERSION = "$NSIBLE_VERSION";
// }-.]
EOF
    fi
    if [ ! -d "assets/.gzl" ]; then mkdir -p "assets/.gzl"; fi
    if [ ! -f "assets/.gzl/.void" ]; then
        run_with_loader "FORGING TEMPORAL DECAY VOID..." sleep 0.1
        {
            cat << EOF 
// [@://nsible_os/assets/.gzl/.void/.-={
//   module: "Temporal Decay Void",
//   description: "Graveyard for banished artifacts and dormant logic.",
//   philotic_inferences: "Nothing is truly lost; it merely awaits reclamation."
EOF
            echo "// }-.]"
        } > "assets/.gzl/.void"
    fi
    run_with_loader "COMPILING SOVEREIGN KERNEL..." /home/static/.local/bin/zig build
    if [ $? -eq 0 ]; then
        tput cnorm; tput sgr0; clear; rm -f .nsible_job.log
        trap - EXIT SIGINT SIGTERM 
        exec sudo -E ./zig-out/bin/nsible_os
    else
        tput cnorm; tput sgr0
        echo -e "\n$(L "C.H")[ ! ] BUILD FAILED. TRACE WRITTEN TO BLACK BOX (assets/.void/.trail.tome).${RESET}\n"
        cat .nsible_job.log | sudo tee assets/.void/.trail.tome > /dev/null
        cat .nsible_job.log; rm -f .nsible_job.log; exit 1
    fi
elif [ "$cmd" = "log" ]; then
    tput cnorm; tput sgr0; clear
    echo "[ @NSIBLE :: BLACK BOX ARCHIVE ]"
    if [ -f "assets/.void/.trail.tome" ]; then cat assets/.void/.trail.tome
    else echo "   :: The Void is quiet. No fatal traces found."; fi
elif [ "$cmd" = "purge" ]; then
    tput cnorm; tput sgr0; clear
    echo "[ @NSIBLE :: INITIATING DEEP PURGE ]"
    rm -rf zig-cache zig-out assets/.void/.trail.tome assets/void.tome assets/indexer
    echo "   :: Compiler caches, unlinked assets, and Black Box cleared."
elif [ "$cmd" = "orbit" ]; then
    if [ -f "./zig-out/bin/nsible_os" ]; then
        apply_mastered_dynamics
        tput cnorm; tput sgr0; clear; trap - EXIT SIGINT SIGTERM
        exec sudo -E ./zig-out/bin/nsible_os
    else
        tput cnorm; tput sgr0; clear
        echo -e "$(L "C.H")[ ! ] KERNEL NOT FOUND. RUN './nsible sync' FIRST.${RESET}"
    fi
elif [ "$cmd" = "clean" ]; then
    echo -e "${B_H} >> CLEANING MCHN BUILD ARTIFACTS...${RESET}"
    rm -rf zig-cache/
    echo "Done."
elif [ "$cmd" = "debug" ]; then
    echo -e "${S_H} [ @NSIBLE :: DEBUG MODE ] ${RESET}"
    echo "CMD: $cmd"
    echo "VERSION: $NSIBLE_VERSION"
    echo "LIB: $COLOR_LIB"
elif [ "$cmd" = "shell" ]; then
    echo -e "${B_H} >> OPENING SUB-SHELL IN @NSIBLE ENVIRONMENT... ${RESET}"
    /bin/bash
else
    echo -e "${C_H}[ ! ] UNKNOWN COMMAND: $cmd${RESET}"
    echo "Usage: ./nsible [build|sync|log|purge|orbit|clean|debug|shell]"
    exit 1
fi
