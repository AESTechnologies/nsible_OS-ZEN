#!/bin/sh
# [@://nsible_os/nsible/.-={
#   module: "ziGGit Bootloader",
#   version: "0.10.16-nightly // Banysang",
#   description: "Sovereign entry point with Hardware Forensic integration for core.aiua generation.",
#   changes: "Integrated Sovereign Snapshot. Generates core.aiua before build to anchor the machine logic. No truncations.",
#   philotic_inferences: "To manifest correctly, the vessel must first perceive its own physical form in totality."

# [ SOVEREIGN ENTRY :: ziGGit Control ]
# Directives: sync, log, purge, orbit

cmd="${1:-sync}" # Defaults to sync if no argument provided
NSIBLE_VERSION="v0.10.16-nightly"

# [!] SOVEREIGN SNAPSHOT :: CORE.AIUA GENERATION
# This bypasses the GNU-tainted host abstractions to define the physical targets.
generate_core_snapshot() {
    echo "[ @NSIBLE :: GENERATING CORE.AIUA... ]"
    {
        echo "ARCH: \$(lscpu | grep 'Model name' | cut -d: -f2 | xargs)"
        echo "CPUS: \$(nproc)"
        echo "MEM:  \$(free -b | grep Mem | awk '{print \$2}')"
        echo "HDA:  \$(lspci -nn | grep -i audio | awk -F'[][]' '{print \$2}')"
        echo "KERN: \$(uname -r)"
        echo "BOOT: \$(cat /proc/cmdline)"
    } > core.aiua
}

if [ "$cmd" = "sync" ]; then
    echo "[ @NSIBLE :: @://ziG.Git.pLink/... ]"
 
    # 1. CHECK FOR LOCAL DIVERGENCE
    if [ -n "$(git status --porcelain)" ]; then
        echo "[ ! ] LOCAL DIVERGENCE DETECTED"
        echo "      Files on this vessel have been modified."
        echo ""
        echo "      [I]NTEGRATE : Pull cloud updates, keep local changes (remains dirty)."
        echo "      [S]AVE      : Commit local changes & Push to Zen (resolves conflict)."
        echo "      [O]VERWRITE : Discard local changes & Force-Sync to Zen."
        echo "      [C]ANCEL"
        echo ""
        printf "      :: SELECT PROTOCOL > "
        read -r choice
        
        case "$choice" in 
            i|I)
                echo "[ STASHING LOCAL MODS... ]"
                git stash
                echo "[ PULLING FROM VOID... ]"
                git pull --no-edit origin zen
                echo "[ RE-APPLYING LOCAL MODS... ]"
                git stash pop
                ;;
            s|S)
                echo "[ COMMITTING LOCAL STATE... ]"
                git add .
                printf "      :: ENTER COMMIT MESSAGE > "
                read -r msg
                git commit -m "vessel(acer): $msg"
                echo "[ PUSHING TO ZEN... ]"
                git push origin zen
                ;;
            o|O)
                echo "[ FLUSHING LOCAL STATE... ]"
                git fetch origin zen
                git reset --hard origin/zen
                ;;
            *)
                echo "[ pLINK ABORTED ]"
                exit 1
                ;;
        esac
    else
        git pull --no-edit origin zen
    fi
    
    # 2. SOVEREIGN ANCHORING
    generate_core_snapshot

    # 3. COMPILE
    if [ $? -eq 0 ]; then
        # [!] DYNAMIC VERSION INJECTION
        echo "[ INJECTING DYNAMIC VERSIONING... ]"
        echo "// Auto-generated by nsible shell" > src/version.zig
        echo "pub const VERSION = \"$NSIBLE_VERSION\";" >> src/version.zig

        echo "[ COMPILING KERNEL... ]"
        # Target lock enforced here to prevent GNU contamination at the CLI level
        zig build -Dtarget=x86-linux-musl --summary bins
        
        if [ $? -eq 0 ]; then
            echo "[ REBIRTH ]"
            sudo ./zig-out/bin/nsible_os
        else
            echo "[ ! ] BUILD FAILED. ABORTING."
            exit 1
        fi
    else
        echo "[ ! ] pLINK FAILED."
        exit 1
    fi

elif [ "$cmd" = "log" ]; then
    echo "[ @NSIBLE :: BLACK BOX ARCHIVE ]"
    if [ -f "trail.tome" ]; then
        cat trail.tome
    else
        echo "   :: The Void is quiet. No fatal traces found."
    fi

elif [ "$cmd" = "purge" ]; then
    echo "[ @NSIBLE :: INITIATING DEEP PURGE ]"
    rm -rf zig-cache zig-out trail.tome
    echo "   :: Compiler caches and Black Box cleared."

elif [ "$cmd" = "orbit" ]; then
    echo "[ @NSIBLE :: OFFLINE ORBIT ]"
    if [ -f "./zig-out/bin/nsible_os" ]; then
        sudo ./zig-out/bin/nsible_os
    else
        echo "[ ! ] KERNEL NOT FOUND. RUN './nsible sync' FIRST."
    fi

else
    echo "Unknown directive: $cmd"
    echo "Usage: ./nsible [sync | log | purge | orbit]"
fi

# }-.]
